# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.

# ─── Site identity ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://floridaplatformliftpros.com

# Public business contact info (shown in the UI)
NEXT_PUBLIC_BUSINESS_PHONE=954-613-9330
NEXT_PUBLIC_BUSINESS_EMAIL=contact@floridaplatformliftpros.com

# ─── Lead storage ───────────────────────────────────────────────────────────
# "mock" — in-memory, dev only. Throws at startup in NODE_ENV=production.
# "neon" — Postgres via @neondatabase/serverless. Requires DATABASE_URL.
LEAD_STORAGE_PROVIDER=mock

# Required when LEAD_STORAGE_PROVIDER=neon. Get from Neon dashboard → Connection details.
# Example shape: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Legacy local-dev option (still supported for the legacy /api/lead route):
# "json" — persists to /data/leads.json (gitignored, local FS only)
# Production providers (Airtable / webhook) are not yet implemented.

# ─── Email alerts (Resend) ──────────────────────────────────────────────────
# Generate at https://resend.com/api-keys
RESEND_API_KEY=

# Where new-lead alerts are sent (single address)
INTERNAL_ALERT_EMAIL=contact@floridaplatformliftpros.com

# Verified Resend sender domain. Defaults to leads@floridaplatformliftpros.com if unset.
DEFAULT_FROM_EMAIL=

# Optional mailbox for partner handoff notices once the AI phone service confirms fit.
PARTNER_HANDOFF_EMAIL=

# ─── Admin CRM ──────────────────────────────────────────────────────────────
# Required to access /admin/leads and PATCH /api/leads/:id in production.
# Generate with: openssl rand -base64 32
ADMIN_ACCESS_TOKEN=

# Optional shared secret for future AI phone-service webhooks that update lead status.
AI_PHONE_SERVICE_WEBHOOK_SECRET=

# Recraft API token for local asset generation scripts only.
# Never expose this to the browser and never commit real tokens.
RECRAFT_API_TOKEN=

# Optional public Google Maps embed URL for service-area display.
# Example shape: https://www.google.com/maps/embed?pb=...
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
