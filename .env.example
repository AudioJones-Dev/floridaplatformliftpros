# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.

# Public business contact info (shown in the UI)
NEXT_PUBLIC_BUSINESS_PHONE=954-613-9330
NEXT_PUBLIC_BUSINESS_EMAIL=contact@floridaplatformliftpros.com

# Lead storage provider: "mock" (default, in-memory) or "json" (persists to /data/leads.json)
LEAD_STORAGE_PROVIDER=mock
